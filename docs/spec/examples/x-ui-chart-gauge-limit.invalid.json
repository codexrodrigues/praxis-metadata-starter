{
  "version": "0.1.0",
  "kind": "gauge",
  "source": {
    "kind": "praxis.stats",
    "resource": "/api/procurement/vw-supplier-procurement-funnel",
    "operation": "group-by",
    "options": {
      "limit": 2
    }
  },
  "dimensions": [
    {
      "field": "stage",
      "role": "category"
    }
  ],
  "metrics": [
    {
      "field": "conversionRate",
      "aggregation": "avg"
    }
  ],
  "gauge": {
    "scale": {
      "min": 0,
      "max": 1
    }
  }
}
