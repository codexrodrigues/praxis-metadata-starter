      "groupByCount": {
        "summary": "Group-by por status",
        "value": {
          "field": "status",
          "metric": {
            "operation": "COUNT"
          }
        }
      },
      "linkedContract": {
        "summary": "Contrato externo do request",
        "externalValue": "https://example.org/examples/group-by-request.json"
      }
    },
    "response": {
      "groupByCountResponse": {
        "summary": "Buckets agregados",
        "value": {
          "data": {
            "buckets": []
          }
        }
      }
    }
  }
}
