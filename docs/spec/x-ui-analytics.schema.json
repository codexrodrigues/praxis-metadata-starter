{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis.dev/spec/x-ui-analytics.schema.json",
  "title": "x-ui.analytics - 0.5.0",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    { "required": ["projections"] },
    { "required": ["verifiedRecipes"] }
  ],
  "properties": {
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/projection" }
    },
    "verifiedRecipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "operation", "endpointPath", "governanceTier", "version", "provenanceDigest"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "intent": { "type": "string" },
          "resourceKey": { "type": "string" },
          "resourcePath": { "type": "string" },
          "endpointPath": { "type": "string", "minLength": 1 },
          "operation": {
            "type": "string",
            "enum": ["group-by", "timeseries", "distribution", "comparison"]
          },
          "field": { "type": "string" },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "extraction"],
              "properties": {
                "field": { "type": "string", "minLength": 1 },
                "extraction": { "type": "string" },
                "alias": { "type": "string" }
              }
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation"],
              "properties": {
                "operation": { "type": "string", "minLength": 1 },
                "field": { "type": "string" },
                "alias": { "type": "string" }
              }
            }
          },
          "orderBy": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1 },
          "granularity": { "type": "string" },
          "fillGaps": { "type": "boolean" },
          "distributionMode": { "type": "string" },
          "bucketCount": { "type": "integer", "minimum": 1 },
          "bucketSize": { "type": "number" },
          "timezone": { "type": "string" },
          "periodField": { "type": "string" },
          "periodPreset": { "type": "string" },
          "periodMode": { "type": "string" },
          "lockedFilters": { "type": "object" },
          "adjustableParams": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "dataType", "required"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "filterField": { "type": "string" },
                "description": { "type": "string" },
                "dataType": { "type": "string" },
                "required": { "type": "boolean" },
                "defaultValue": { "type": "string" },
                "allowedValues": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "minValue": { "type": "string" },
                "maxValue": { "type": "string" }
              }
            }
          },
          "governanceTier": {
            "type": "string",
            "enum": ["CERTIFIED", "OPERATIONAL", "EXPLORATORY"]
          },
          "domainTags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "version": { "type": "string", "minLength": 1 },
          "provenanceDigest": { "type": "string", "minLength": 16 }
        }
      }
    }
  },
  "$defs": {
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "intent", "source", "bindings"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "intent": {
          "type": "string",
          "enum": [
            "ranking",
            "trend",
            "distribution",
            "composition",
            "comparison",
            "correlation",
            "matrix",
            "flow",
            "range",
            "multivariate"
          ]
        },
        "source": { "$ref": "#/$defs/source" },
        "bindings": { "$ref": "#/$defs/bindings" },
        "governance": { "$ref": "#/$defs/governance" },
        "defaults": { "$ref": "#/$defs/defaults" },
        "presentationHints": { "$ref": "#/$defs/presentationHints" },
        "interactions": { "$ref": "#/$defs/interactions" }
      },
      "allOf": [
        { "$ref": "#/$defs/comparisonProjection" },
        { "$ref": "#/$defs/crossFilterProjection" }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resource", "operation"],
      "properties": {
        "kind": {
          "type": "string",
          "const": "praxis.stats"
        },
        "resource": { "type": "string", "minLength": 1 },
        "operation": {
          "type": "string",
          "enum": ["group-by", "timeseries", "distribution", "comparison", "inference", "anomalies", "simulation", "counterfactual"]
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryMetrics"],
      "properties": {
        "primaryDimension": { "$ref": "#/$defs/dimension" },
        "secondaryDimension": { "$ref": "#/$defs/dimension" },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "primaryMetrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metric" }
        },
        "secondaryMetrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/metric" }
        },
        "comparisonPeriod": { "$ref": "#/$defs/comparisonPeriod" }
      }
    },
    "comparisonPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "timezone", "preset", "mode"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "preset": {
          "type": "string",
          "enum": ["TODAY", "YESTERDAY", "LAST_7_DAYS", "LAST_30_DAYS", "THIS_MONTH", "LAST_MONTH", "THIS_QUARTER", "THIS_YEAR"]
        },
        "mode": {
          "type": "string",
          "enum": ["PREVIOUS_ALIGNED", "PREVIOUS_CALENDAR_PERIOD"]
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "extraction": {
          "type": "string",
          "enum": [
            "NONE",
            "HOUR_OF_DAY",
            "DAY_OF_WEEK",
            "DAY_OF_MONTH",
            "MONTH_OF_YEAR",
            "QUARTER_OF_YEAR",
            "HOUR",
            "DAY",
            "WEEK",
            "MONTH",
            "QUARTER",
            "YEAR"
          ]
        },
        "alias": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "keyFilterField": { "type": "string", "minLength": 1 }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "aggregation": {
          "type": "string",
          "enum": [
            "count",
            "distinct-count",
            "sum",
            "avg",
            "min",
            "max",
            "percentile-25",
            "median",
            "percentile-75",
            "percentile-90",
            "percentile-95",
            "avg-per-cycle-occurrence",
            "histogram"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "alias": { "type": "string", "minLength": 1 }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyRefs"],
      "properties": {
        "policyRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/policyRef" }
        }
      }
    },
    "policyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policyVersion", "role", "resultField"],
      "properties": {
        "policyId": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "resultField": { "type": "string", "minLength": 1 },
        "attestation": { "$ref": "#/$defs/policyAttestation" }
      }
    },
    "policyAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyIdField", "policyVersionField"],
      "properties": {
        "policyIdField": { "type": "string", "minLength": 1 },
        "policyVersionField": { "type": "string", "minLength": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sort": {
          "type": "array",
          "items": { "$ref": "#/$defs/sort" }
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "distributionMode": {
          "type": "string",
          "enum": ["terms", "histogram"]
        },
        "bucketSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bucketCount": {
          "type": "integer",
          "minimum": 1
        },
        "granularity": {
          "type": "string",
          "enum": ["day", "week", "month"]
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "periodPreset": {
          "type": "string",
          "enum": ["TODAY", "YESTERDAY", "LAST_7_DAYS", "LAST_30_DAYS", "THIS_MONTH", "LAST_MONTH", "THIS_QUARTER", "THIS_YEAR"]
        },
        "fillGaps": {
          "type": "boolean"
        }
      }
    },
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "direction"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "direction": {
          "type": "string",
          "enum": ["asc", "desc"]
        }
      }
    },
    "presentationHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferredFamilies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["chart", "analytic-table", "kpi", "summary-list"]
          }
        }
      }
    },
    "interactions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drillDown": { "type": "boolean" },
        "pointSelection": { "type": "boolean" },
        "crossFilter": { "type": "boolean" },
        "recordOpen": { "$ref": "#/$defs/recordOpen" }
      }
    },
    "recordOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIdentityField", "target"],
      "properties": {
        "sourceIdentityField": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/surfaceTarget" }
      }
    },
    "surfaceTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceKey", "surfaceId"],
      "properties": {
        "resourceKey": { "type": "string", "minLength": 1 },
        "surfaceId": { "type": "string", "minLength": 1 }
      }
    },
    "comparisonProjection": {
      "if": {
        "properties": {
          "source": {
            "properties": { "operation": { "const": "comparison" } },
            "required": ["operation"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "bindings": { "required": ["comparisonPeriod"] }
        }
      }
    },
    "crossFilterProjection": {
      "if": {
        "properties": {
          "interactions": {
            "properties": {
              "crossFilter": { "const": true }
            },
            "required": ["crossFilter"]
          }
        },
        "required": ["interactions"]
      },
      "then": {
        "properties": {
          "bindings": {
            "anyOf": [
              {
                "required": ["primaryDimension"],
                "properties": {
                  "primaryDimension": {
                    "required": ["keyFilterField"]
                  },
                  "secondaryDimension": {
                    "required": ["keyFilterField"]
                  }
                }
              },
              {
                "required": ["dimensions"],
                "properties": {
                  "dimensions": {
                    "items": {
                      "required": ["keyFilterField"]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
