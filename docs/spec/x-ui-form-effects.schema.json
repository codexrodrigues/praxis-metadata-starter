{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis.dev/spec/x-ui-form-effects.schema.json",
  "title": "x-ui form effects — 1.0.0",
  "type": "array",
  "items": { "$ref": "#/$defs/formEffect" },
  "$defs": {
    "formEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "operation", "inputs", "outputs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "trigger": { "$ref": "#/$defs/trigger" },
        "operation": { "$ref": "#/$defs/operation" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/inputBinding" }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outputBinding" }
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "fields", "debounceMs", "requiresValidSources"],
      "properties": {
        "event": { "const": "value-change" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "debounceMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "requiresValidSources": { "type": "boolean" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "path", "method", "requestSchemaUrl", "responseSchemaUrl"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "method": { "const": "POST" },
        "requestSchemaUrl": { "type": "string", "pattern": "^/schemas/filtered\\?" },
        "responseSchemaUrl": { "type": "string", "pattern": "^/schemas/filtered\\?" }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formField", "operationField"],
      "properties": {
        "formField": { "type": "string", "minLength": 1 },
        "operationField": { "type": "string", "minLength": 1 }
      }
    },
    "outputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationField", "formField", "writePolicy"],
      "properties": {
        "operationField": { "type": "string", "minLength": 1 },
        "formField": { "type": "string", "minLength": 1 },
        "writePolicy": { "enum": ["if-pristine", "if-empty", "replace"] }
      }
    }
  }
}
