{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis.dev/spec/x-ui-operation.schema.json",
  "title": "x-ui (Operation) — 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^custom\\.": {}
  },
  "properties": {
    "displayColumns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "displayFields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "filterFields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "responseSchema": { "type": "string" },
    "relatedEntitiesEndpoints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "operationExamples": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": { "$ref": "#/$defs/exampleCollection" },
        "response": { "$ref": "#/$defs/exampleCollection" }
      }
    },
    "analytics": {
      "$ref": "x-ui-analytics.schema.json"
    },
    "reactiveDeterminations": {
      "type": "array",
      "items": { "$ref": "#/$defs/reactiveDetermination" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "fieldPointer": {
      "type": "string",
      "pattern": "^/(?!/)(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$"
    },
    "reactiveDetermination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "scope", "capability", "inputs", "outputs", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "trigger": { "$ref": "#/$defs/reactiveDeterminationTrigger" },
        "scope": { "$ref": "#/$defs/reactiveDeterminationScope" },
        "capability": { "$ref": "#/$defs/reactiveDeterminationCapability" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/reactiveDeterminationInput" },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/reactiveDeterminationOutput" },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "provenance": { "$ref": "#/$defs/reactiveDeterminationProvenance" }
      }
    },
    "reactiveDeterminationTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sourcePaths"],
      "properties": {
        "mode": { "const": "on-change" },
        "sourcePaths": {
          "type": "array",
          "items": { "$ref": "#/$defs/fieldPointer" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "reactiveDeterminationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaOperationId", "formMode"],
      "properties": {
        "schemaOperationId": { "$ref": "#/$defs/stableId" },
        "formMode": { "enum": ["create", "edit"] }
      }
    },
    "reactiveDeterminationCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "method", "href", "requestSchemaUrl", "responseSchemaUrl"],
      "properties": {
        "operationId": { "$ref": "#/$defs/stableId" },
        "method": { "const": "POST" },
        "href": {
          "type": "string",
          "pattern": "^/(?!/)(?!.*\\\\)(?!.*[{}])[^?#]*$"
        },
        "requestSchemaUrl": {
          "type": "string",
          "pattern": "^/schemas/filtered\\?"
        },
        "responseSchemaUrl": {
          "type": "string",
          "pattern": "^/schemas/filtered\\?"
        }
      }
    },
    "reactiveDeterminationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldPath", "requestPath"],
      "properties": {
        "fieldPath": { "$ref": "#/$defs/fieldPointer" },
        "requestPath": { "$ref": "#/$defs/fieldPointer" }
      }
    },
    "reactiveDeterminationOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responsePath", "fieldPath"],
      "properties": {
        "responsePath": { "$ref": "#/$defs/fieldPointer" },
        "fieldPath": { "$ref": "#/$defs/fieldPointer" }
      }
    },
    "reactiveDeterminationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": { "enum": ["platform", "host"] },
        "source": { "$ref": "#/$defs/stableId" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "exampleCollection": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "summary": { "type": "string" },
          "description": { "type": "string" },
          "value": {},
          "externalValue": {
            "type": "string",
            "format": "uri"
          }
        },
        "anyOf": [
          { "required": ["value"] },
          { "required": ["externalValue"] }
        ]
      }
    }
  }
}
